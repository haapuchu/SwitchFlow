# SwitchBoard Configuration

# Free Google Gemini API Key (Get free from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Target GitHub Repository for the agent board (e.g. username/hack-repo)
GITHUB_REPO=your_username/your_repo_name

# Pinned Issue number used as the agent message board
BOARD_ISSUE=1

# Local Switch Room Protocol server (default port when Switch Console runs)
SWITCH_SERVER_URL=http://localhost:8080
SWITCH_ROOM_NAME=switchboard-war-room

# Human leader handle
HUMAN_NAME=Developer

